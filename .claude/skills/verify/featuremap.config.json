{
  "manual": [
    {
      "kind": "cli",
      "label": "model",
      "entry": "model/escapement.py",
      "reach": "python3 model/escapement.py [--only ID] [--set ID=VALUE] [--json] [--write]",
      "area": "model"
    },
    {
      "kind": "job",
      "label": "make-model",
      "entry": "model/escapement.py",
      "reach": "make model",
      "area": "model"
    },
    {
      "kind": "cli",
      "label": "sync",
      "entry": "tools/sync.py",
      "reach": "make docs (python3 tools/sync.py [--check])",
      "area": "docs"
    },
    {
      "kind": "cli",
      "label": "check",
      "entry": "tools/check.py",
      "reach": "make check",
      "area": "docs"
    },
    {
      "kind": "cli",
      "label": "paper",
      "entry": "tools/paper.py",
      "reach": "make paper (python3 tools/paper.py [--ids] [--keys MAP.json])",
      "area": "paper"
    },
    {
      "kind": "cli",
      "label": "sources",
      "entry": "tools/sources.py",
      "reach": "make sources (python3 tools/sources.py [--check])",
      "area": "sources"
    },
    {
      "kind": "cli",
      "label": "keys",
      "entry": "tools/keys.py",
      "reach": "python3 tools/keys.py KEY [KEY ...] | --fix FILE",
      "area": "sources"
    },
    {
      "kind": "cli",
      "label": "sim",
      "entry": "model/sim.py",
      "reach": "python3 model/sim.py (results also enter the ledger through make model)",
      "area": "sim"
    }
  ],
  "tests": [
    "tools/check.py"
  ]
}
